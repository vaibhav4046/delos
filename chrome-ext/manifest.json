{
  "manifest_version": 3,
  "name": "DelOS — Agents Under Pressure",
  "short_name": "DelOS",
  "version": "3.1.0",
  "description": "Unified Mission agent · browser tasks + endless conversation + chain re-plan + Perplexity-style in-page overlay + cohort racing + cross-device Hydra memory. 3 tabs · Mission, Cohort, Memory.",
  "author": "DelOS",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "action": {
    "default_title": "Open DelOS",
    "default_icon": {
      "16": "icon.svg",
      "32": "icon.svg",
      "48": "icon.svg",
      "128": "icon.svg"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*", "https://*.delrio.app/*", "https://delrio.vercel.app/*"],
      "js": ["content-sync.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["sidePanel", "storage", "activeTab", "scripting", "contextMenus", "identity"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.delrio.app/*",
    "https://delrio.vercel.app/*",
    "https://api.hydradb.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "Open DelOS side panel"
    }
  }
}
