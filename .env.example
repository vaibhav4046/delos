# ───────────────────────────────────────────────────────────────────────
# DelOS / DelRio · environment template
# ───────────────────────────────────────────────────────────────────────
# Copy to .env.local for dev. Never commit a real .env.local — it's in
# .gitignore. Vercel: set the same vars in Project Settings → Environment.
# Anything blank below is OPTIONAL — the platform pool / demo fallback
# covers missing keys, but features marked "[required]" need the key to
# work in prod.

# ── HydraDB · persistent memory graph + vector store ─────────────────
# [required for cross-session memory] · platform falls back to local
# in-memory store when missing, so demos still work but recall doesn't
# persist across cold starts.
HYDRA_DB_API_KEY=

# ── LLM providers · at least one of these MUST be set ───────────────
# [recommended] free dev tier · groq.com
GROQ_API_KEY=
# [recommended] free dev tier · mistral.ai
MISTRAL_API_KEY=
# [recommended] free tier · ai.google.dev (Gemini 2.5)
GOOGLE_GENERATIVE_AI_API_KEY=
# [optional] Cerebras Inference · ultra-fast first-token. cerebras.ai
CEREBRAS_API_KEY=
# [optional] NVIDIA NIM · build.nvidia.com (large free tier)
# Code reads NVIDIA_NIM_API_KEY (see src/lib/llm/providers/nim.ts).
NVIDIA_NIM_API_KEY=
# Optional override for a self-hosted / proxy NIM endpoint.
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Voice · ElevenLabs TTS ──────────────────────────────────────────
# [optional · falls back to browser SpeechSynthesis when missing]
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ── MCP / OAuth connectors ──────────────────────────────────────────
# Demo-mode flags default to ON so the autonomous Gmail/Notion path
# returns a simulated success when no OAuth is configured. Set to "0"
# to force the real path (will 401 until OAuth is wired up).
GMAIL_DEMO_MODE=1
NOTION_DEMO_MODE=1

# [optional] Gmail OAuth — console.cloud.google.com → APIs & Services
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# [optional] Notion OAuth — notion.so/my-integrations
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=

# [optional] GitHub OAuth — github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# [optional] Google Drive — shares the GMAIL_* client ID by default
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REDIRECT_URI=

# ── Session ──────────────────────────────────────────────────────────
# [required for prod] HMAC secret for the signed `delos_session` cookie.
# This is the single source every auth/crypto module reads (session signing,
# tenant derivation, connector-token encryption). Long random string ·
# openssl rand -hex 48. Without it, prod refuses to sign/verify (throws).
AUTH_SECRET=
# [optional] Override key for connector-token AES-GCM (cryptoBag). Falls back
# to AUTH_SECRET when unset — set only if you rotate cipher keys separately.
DELRIO_SECRET=

# ── Tenancy ──────────────────────────────────────────────────────────
# Default tenant when no session/anon-IP can be resolved.
DELRIO_TENANT_ID=delrio_demo
NEXT_PUBLIC_APP_NAME=Del Rio
