{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Del Rio",
  "version": "2.0.0",
  "identifier": "com.delrio.app",
  "build": {
    "frontendDist": "../.next",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm run build",
    "beforeDevCommand": "node ./node_modules/next/dist/bin/next dev -p 3000"
  },
  "app": {
    "windows": [
      {
        "title": "Del Rio",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "fullscreen": false,
        "resizable": true,
        "transparent": false,
        "decorations": true,
        "backgroundColor": "#0f0f1b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "Productivity",
    "copyright": "© 2026 Del Rio",
    "shortDescription": "Agents that flow under pressure.",
    "longDescription": "DelOS — a browser-OS where multi-agent orchestration is a first-class citizen. Memory, Tools, Recovery, Adaptation."
  }
}
